<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,700;1,400;1,700&family=Merriweather:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Fira+Code&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/vanilla.css">
        <title>{{ page.title }}</title>
    </head>
    <body>
  <header class="site-header">
    <h1><a href="/">{{ page.title }}</a></h1>
    <nav class="site-nav">
      <a href="/">/home/bolun</a>
      <a href="/posts">/home/bolun/posts</a>
    </nav>
  </header>
  <aside class="site-sidebar">
    <nav class="sidebar-nav">
      <ul>
        <li><a href="/#about-me">About me</a></li>
        <li><a href="/#projects">Projects</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </nav>
  </aside>
  <main class="site-content">
    {{ page.content }}

    {% if page.updates %}
    <section class="updates-section">
      <h2>Updates</h2>
      <ul class="updates-list">
      {% for update in page.updates %}
        <li>{{ update }}</li>
      {% endfor %}
      </ul>
    </section>
    {% endif %}
  </main>
    </body>
</html>
